{
  "name": "rounds-campus-it",
  "version": "0.1.0",
  "private": true,
  "description": "Campus IT room rounds desktop app",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "web:build": "node scripts/build-browser.cjs",
    "mobile:prepare": "node mobile/prepare.cjs",
    "android:debug": "npm run mobile:prepare && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "read-excel-file": "9.3.17",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "electron": "42.11.16"
  }
}
